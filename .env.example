# Supabase project: zghysuwvfdncnnyvesas
NEXT_PUBLIC_SUPABASE_URL=https://zghysuwvfdncnnyvesas.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-project-publishable-key
# Canonical public URL used in Supabase magic-link callbacks.
NEXT_PUBLIC_APP_URL=https://cocoa-elisha-afaris-projects.vercel.app

# Operator-only test targets. Set these in the shell or CI job rather than the
# browser runtime. LOAD_BASE_URL should normally point at staging.
SMOKE_BASE_URL=https://cocoa-elisha-afaris-projects.vercel.app
LOAD_BASE_URL=https://staging.example.com
LOAD_REQUESTS=100
LOAD_CONCURRENCY=10

# Local database tooling only. Never add either value to Vercel or expose them
# with a NEXT_PUBLIC_ prefix.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF@HOST:6543/postgres
SUPABASE_DB_PASSWORD=replace-with-your-database-password

# Optional read-only operations audit. Create a short-lived, fine-grained
# Supabase Management API token with auth_config_read and backups_read only.
SUPABASE_PROJECT_REF=zghysuwvfdncnnyvesas
SUPABASE_ACCESS_TOKEN=replace-with-a-short-lived-fine-grained-token
REQUIRE_PITR=false
